# JDK 21 GitLab Runner 镜像
# 基于 Eclipse Temurin JDK 21 (官方 OpenJDK 发行版)
FROM eclipse-temurin:21-jdk

LABEL maintainer="devops@example.com"
LABEL description="GitLab Runner with JDK 21, Maven 3.9, Docker, kubectl"

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    MAVEN_VERSION=3.9.9 \
    MAVEN_HOME=/opt/apache-maven-3.9.9 \
    KUBECTL_VERSION=v1.28.0 \
    DOCKER_VERSION=24.0.7

ENV PATH=$MAVEN_HOME/bin:$PATH

# 安装基础工具
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    openssh-client \
    ca-certificates \
    apt-transport-https \
    software-properties-common \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# 安装 GitLab Runner（使用最新稳定版本）
RUN curl -L "https://packages.gitlab.com/install/repositories/runner/gitlab-runner/script.deb.sh" | bash && \
    apt-get update && \
    apt-get install -y gitlab-runner && \
    rm -rf /var/lib/apt/lists/*

# 安装 Maven 3.9.9（JDK 21 兼容）
RUN cd /tmp && \
    wget https://archive.apache.org/dist/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.tar.gz && \
    tar -xzf apache-maven-${MAVEN_VERSION}-bin.tar.gz -C /opt/ && \
    rm apache-maven-${MAVEN_VERSION}-bin.tar.gz && \
    ln -s /opt/apache-maven-${MAVEN_VERSION} /opt/maven

# 安装 Docker 客户端
RUN cd /tmp && \
    wget https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz && \
    tar xzvf docker-${DOCKER_VERSION}.tgz && \
    cp docker/docker /usr/local/bin/ && \
    rm -rf docker docker-${DOCKER_VERSION}.tgz

# 安装 kubectl
RUN curl -LO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" && \
    install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl && \
    rm kubectl

# 复制 Maven settings.xml（如果存在）
COPY .m2/ /root/.m2/

# 复制 SSH 配置（用于拉取私有仓库）
COPY .ssh/ /root/.ssh/
RUN chmod 700 /root/.ssh && \
    chmod 600 /root/.ssh/* 2>/dev/null || true

# 验证安装
RUN java -version && \
    mvn -version && \
    docker --version && \
    kubectl version --client && \
    git --version && \
    gitlab-runner --version

# 创建工作目录
RUN mkdir -p /etc/gitlab-runner /root/builds

WORKDIR /root

# 启动 gitlab-runner（在 K8s 中会被 StatefulSet 覆盖）
CMD ["gitlab-runner", "run", "--working-directory=/root/builds", "--config=/etc/gitlab-runner/config.toml"]
